# Editor defaults for every contributor and editor.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are used for Markdown line breaks; keep them.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
