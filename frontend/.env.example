# API endpoint root — VITE_ prefix makes it available at import.meta.env.
#
# Dev: keep the relative default; Vite proxies /api → http://localhost:4000
# (see vite.config.js server.proxy).
VITE_API_BASE=/api

# Production (Option B — static frontend on S3+CDN, API on its own subdomain).
# Bake the absolute URL at build time:
#   VITE_API_BASE=https://api.compmasone.ru/api npm run build
# VITE_API_BASE=https://api.compmasone.ru/api
