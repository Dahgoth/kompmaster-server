# Storefront runtime/build configuration (ADR 007).
# Copy to .env.local for development; production values are set by the deploy
# pipeline at build time (RUNBOOK §4.4).

# API base for server-side fetches. Production: https://api.compmasone.ru/api
API_BASE=http://localhost:4000/api

# Yandex Metrika counter id (optional; loader is a no-op when unset)
METRIKA_ID=

# Secret for the on-demand ISR revalidate route (Phase 2)
REVALIDATE_SECRET=

# IndexNow key (Phase 3)
INDEXNOW_KEY=
