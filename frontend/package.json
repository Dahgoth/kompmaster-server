{
  "name": "kompmaster-frontend",
  "version": "2.0.0",
  "description": "KompMaster storefront — self-hosted Next.js SSR/ISR storefront (ADR 006/007)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm -w run lint:frontend",
    "test": "vitest run --root .",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium webkit"
  },
  "keywords": [
    "kompmaster",
    "storefront",
    "pc-parts",
    "nextjs",
    "react"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^30.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "clsx": "^2.1.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
