# KompMaster server — environment configuration.
# Copy to .env and fill in real values:  cp .env.example .env
# See ENVIRONMENT.md for the full reference.

# --- Core ---
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=*

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://kompmaster:kompmaster@localhost:5432/kompmaster

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
# "Second password" required to enter the admin panel. Change from the default.
ADMIN_PANEL_PASSWORD=CHANGE_ME

# --- S3-compatible object storage (photos) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kompmaster
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_PUBLIC_URL=http://localhost:9000/kompmaster

# --- SMTP (password-reset e-mail) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- SMS (phone confirmation) ---
SMS_PROVIDER_API_URL=https://sms.ru/sms/send
SMS_PROVIDER_API_ID=

# --- Telegram admin notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics ---
YANDEX_METRIKA_ID=
